#!/usr/bin/env bash
# Build an unsigned iOS Runner.app from a frozen spec. Signing happens later.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=scripts/lib/common.sh
source "${ROOT_DIR}/scripts/lib/common.sh"
RUNALL_ROOT="$ROOT_DIR"
# shellcheck source=scripts/lib/build_release.sh
source "${ROOT_DIR}/scripts/lib/build_release.sh"

usage() {
  cat <<'EOF'
Usage: build-ios --spec <path> --workspace <dir> [--output-dir <dir>]

The workspace must already contain a detached checkout at the frozen SHAs.
This script refuses signing material and does not produce an IPA.
EOF
}

SPEC=""
WORKSPACE=""
OUTPUT_DIR="${RUNALL_ARTIFACT_DIR:-artifacts}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --spec) SPEC="$2"; shift 2 ;;
    --workspace) WORKSPACE="$2"; shift 2 ;;
    --output-dir) OUTPUT_DIR="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) log "unknown argument: $1"; usage; exit 1 ;;
  esac
done

assert_non_empty "--spec" "$SPEC"
assert_non_empty "--workspace" "$WORKSPACE"
if [[ -n "${ANDROID_KEYSTORE_PATH:-}${IOS_CERTIFICATE_PASSWORD:-}${IOS_CERTIFICATE_P12:-}${IOS_PROVISIONING_PROFILE:-}${CODE_SIGN_IDENTITY:-}" ]]; then
  log "build-ios refuses signing material"
  exit 1
fi

OUTPUT_DIR="$(absolute_path "$OUTPUT_DIR")"
mkdir -p "$OUTPUT_DIR"
prepare_frozen_workspace "$SPEC" "$WORKSPACE"

platform="$(json_get "$SPEC" '.platform')"
if [[ "$platform" != "ios" ]]; then
  log "build-ios requires platform ios"
  exit 1
fi
info_plist="${APP_DIR}/ios/Runner/Info.plist"
if [[ ! -f "$info_plist" ]]; then
  log "ios Info.plist missing"
  exit 1
fi

gen_dir="${APP_DIR}/.runall/native-build"
generate_frozen_release "$gen_dir"
bundle_id="$FROZEN_BUNDLE_ID"
display_name="$FROZEN_DISPLAY_NAME"
version_name="$FROZEN_VERSION_NAME"
version_code="$FROZEN_VERSION_CODE"
assert_non_empty "bundleId" "$bundle_id"
assert_non_empty "displayName" "$display_name"
branded="${APP_DIR}/ios/Flutter/Branded.xcconfig"
if [[ ! -f "$branded" ]]; then
  log "frozen Branded.xcconfig missing"
  exit 1
fi
export IOS_BUNDLE_ID="$bundle_id"
export APP_DISPLAY_NAME="$display_name"
(cd "$APP_DIR" && "$RUNALL_FLUTTER" pub get)
(cd "$APP_DIR" && "$RUNALL_FLUTTER" build ios --release --no-codesign \
  --build-name "$version_name" --build-number "$version_code" \
  --dart-define-from-file "$gen_dir/dart-defines.json")

app_path="${APP_DIR}/build/ios/iphoneos/Runner.app"
if [[ ! -d "$app_path" || -L "$app_path" ]]; then
  log "unsigned Runner.app missing"
  exit 1
fi
rm -rf "${OUTPUT_DIR}/Runner.app"
cp -a "$app_path" "${OUTPUT_DIR}/Runner.app"
python3 - "${OUTPUT_DIR}/Runner.app/Info.plist" "$bundle_id" "$display_name" "$version_name" "$version_code" <<'PY'
import plistlib, sys
from pathlib import Path
info = plistlib.loads(Path(sys.argv[1]).read_bytes())
bundle_id, display_name, version_name, version_code = sys.argv[2:]
if info.get("CFBundleIdentifier") != bundle_id:
    raise SystemExit("built app bundle id mismatch")
if info.get("CFBundleDisplayName") != display_name:
    raise SystemExit("built app display name mismatch")
if str(info.get("CFBundleShortVersionString", "")) != version_name:
    raise SystemExit("built app version mismatch")
if str(info.get("CFBundleVersion", "")) != version_code:
    raise SystemExit("built app build number mismatch")
PY
# upload-artifact does not preserve .app symlinks or modes. Pack them in tar.
rm -f "${OUTPUT_DIR}/Runner.app.tar"
tar -cf "${OUTPUT_DIR}/Runner.app.tar" -C "$OUTPUT_DIR" Runner.app
rm -rf "${OUTPUT_DIR}/Runner.app"
log "unsigned ios app archive in $OUTPUT_DIR"
