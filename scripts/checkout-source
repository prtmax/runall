#!/usr/bin/env bash
# Clone and pin source repository at a requested Git ref (tag, branch, commit, or "latest").
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=scripts/lib/common.sh
source "${ROOT_DIR}/scripts/lib/common.sh"

usage() {
  cat <<'EOF'
Usage: checkout-source --spec <path> --workspace <dir>

Environment:
  COSMOS_BUILD_REPOSITORY_TOKEN  Optional token for private git clones (prepare job only)
EOF
}

SPEC=""
WORKSPACE=""
RESOLVE_ONLY=0
RESOLVED_SHA=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --spec) SPEC="$2"; shift 2 ;;
    --workspace) WORKSPACE="$2"; shift 2 ;;
    --resolve-only) RESOLVE_ONLY=1; shift ;;
    --resolved-sha) RESOLVED_SHA="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) log "unknown argument: $1"; usage; exit 1 ;;
  esac
done

assert_non_empty "--spec" "$SPEC"
assert_non_empty "--workspace" "$WORKSPACE"
validate_build_spec_document "$SPEC"

repository="$(json_get "$SPEC" '.buildInput.source.repository')"
source_ref="$(read_source_ref "$SPEC")"

mkdir -p "$WORKSPACE"

origin_url="$(source_origin_url "$repository")"

# Pass the clone token only as a per-command http.extraheader.
# Never put it in the remote URL or git config.
git_with_auth() {
  if [[ -z "${COSMOS_BUILD_REPOSITORY_TOKEN:-}" ]]; then
    git "$@"
    return
  fi
  local basic
  basic="$(printf 'x-access-token:%s' "$COSMOS_BUILD_REPOSITORY_TOKEN" | base64 | tr -d '\n')"
  git -c "http.extraheader=AUTHORIZATION: basic ${basic}" "$@"
}

if [[ ! -d "${WORKSPACE}/.git" ]]; then
  git init "$WORKSPACE"
  git -C "$WORKSPACE" remote add origin "$origin_url"
fi

git -C "$WORKSPACE" remote set-url origin "$origin_url"
checkout_revision() {
  local revision="$1"
  git -C "$WORKSPACE" rev-parse "${revision}^{commit}" > "$WORKSPACE/.git/runall-resolved-sha"
  if [[ "$RESOLVE_ONLY" == 0 ]]; then git_with_auth -C "$WORKSPACE" checkout --detach "$revision"; fi
}
if [[ -n "$RESOLVED_SHA" ]]; then
  [[ "$RESOLVED_SHA" =~ ^[0-9a-f]{40}$ ]] || exit 1
  checkout_revision "$RESOLVED_SHA"
elif [[ "$source_ref" == "latest" ]]; then
  if ! git_with_auth -C "$WORKSPACE" fetch --tags --force origin; then
    log "trusted Orion tags fetch failed"
    exit 1
  fi
  resolved_tag="$(git -C "$WORKSPACE" tag --list --sort=-version:refname | head -n 1)"
  if [[ -n "$resolved_tag" ]]; then
    checkout_revision "$resolved_tag"
  else
    if ! git_with_auth -C "$WORKSPACE" fetch origin \
      refs/heads/main:refs/remotes/origin/main; then
      log "trusted Orion main fetch failed"
      exit 1
    fi
    checkout_revision refs/remotes/origin/main
  fi
elif [[ "$source_ref" == "main" ]]; then
  if ! git_with_auth -C "$WORKSPACE" fetch origin \
    refs/heads/main:refs/remotes/origin/main; then
    log "trusted Orion main fetch failed"
    exit 1
  fi
  checkout_revision refs/remotes/origin/main
else
  if ! git_with_auth -C "$WORKSPACE" fetch --tags --force origin "$source_ref"; then
    log "trusted Orion ref fetch failed: $source_ref"
    exit 1
  fi
  if git -C "$WORKSPACE" rev-parse --verify "${source_ref}^{commit}" >/dev/null 2>&1; then
    checkout_revision "$source_ref"
  else
    checkout_revision FETCH_HEAD
  fi
fi

if [[ "$RESOLVE_ONLY" == 1 ]]; then exit 0; fi
actual_source="$(git -C "$WORKSPACE" rev-parse HEAD)"
if [[ "$source_ref" =~ ^[0-9a-f]{40}$ && "$actual_source" != "$source_ref" ]]; then
  log "source HEAD mismatch"
  exit 1
fi
origin_actual="$(git -C "$WORKSPACE" remote get-url origin)"
if [[ "$origin_actual" != "$origin_url" ]]; then
  log "source remote URL is not the public https origin"
  exit 1
fi

resolve_release_app_dir "$WORKSPACE" "$source_ref" "$source_ref" >/dev/null
verify_lock_digest_if_present "$SPEC" "$WORKSPACE"
if [[ -n "${COSMOS_BUILD_REPOSITORY_TOKEN:-}" ]]; then
  mkdir -p "${WORKSPACE}/.git/runall-mirrors"
  dependencies="$(run_dart_tool private-git-dependencies "$WORKSPACE")"
  while read -r repo_name locked_refs; do
    [[ -n "$repo_name" ]] || continue
    dep_url="https://github.com/prtmax/${repo_name}.git"
    mirror_dir="${WORKSPACE}/.git/runall-mirrors/${repo_name}.git"
    rm -rf "$mirror_dir"
    if ! git_with_auth clone --mirror "$dep_url" "$mirror_dir"; then
      log "failed to mirror private git dependency: $dep_url"
      exit 1
    fi
    [[ -n "$locked_refs" ]] || continue
    read -r -a revisions <<< "$locked_refs"
    for sha in "${revisions[@]}"; do
      if ! git -C "$mirror_dir" cat-file -e "${sha}^{commit}" 2>/dev/null; then
        git_with_auth -C "$mirror_dir" fetch --no-tags origin "$sha"
      fi
      [[ "$(git -C "$mirror_dir" cat-file -t "$sha")" == commit ]] || exit 1
      git -C "$mirror_dir" update-ref "refs/runall/locked/$sha" "$sha"
    done
  done <<< "$dependencies"
fi
log "source checkout ready at $actual_source (ref $source_ref)"
