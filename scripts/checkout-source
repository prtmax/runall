#!/usr/bin/env bash
# Clone and pin source repository at a requested Git ref (tag, branch, commit, or "latest").
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=scripts/lib/common.sh
source "${ROOT_DIR}/scripts/lib/common.sh"

usage() {
  cat <<'EOF'
Usage: checkout-source --spec <path> --workspace <dir>

Environment:
  COSMOS_BUILD_REPOSITORY_TOKEN  Optional token for private git clones (prepare job only)
EOF
}

SPEC=""
WORKSPACE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --spec) SPEC="$2"; shift 2 ;;
    --workspace) WORKSPACE="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) log "unknown argument: $1"; usage; exit 1 ;;
  esac
done

assert_non_empty "--spec" "$SPEC"
assert_non_empty "--workspace" "$WORKSPACE"
validate_build_spec_document "$SPEC"

repository="$(json_get "$SPEC" '.buildInput.source.repository')"
source_ref="$(read_source_ref "$SPEC")"

mkdir -p "$WORKSPACE"

origin_url="$(source_origin_url "$repository")"

# Pass the clone token only as a per-command http.extraheader.
# Never put it in the remote URL or git config.
git_with_auth() {
  if [[ -z "${COSMOS_BUILD_REPOSITORY_TOKEN:-}" ]]; then
    git "$@"
    return
  fi
  local basic
  basic="$(printf 'x-access-token:%s' "$COSMOS_BUILD_REPOSITORY_TOKEN" | base64 | tr -d '\n')"
  git -c "http.extraheader=AUTHORIZATION: basic ${basic}" "$@"
}

if [[ ! -d "${WORKSPACE}/.git" ]]; then
  git init "$WORKSPACE"
  git -C "$WORKSPACE" remote add origin "$origin_url"
fi

git -C "$WORKSPACE" remote set-url origin "$origin_url"
if [[ "$source_ref" == "latest" ]]; then
  if ! git_with_auth -C "$WORKSPACE" fetch --filter=blob:none --tags --force origin; then
    log "trusted Orion tags fetch failed"
    exit 1
  fi
  resolved_tag="$(git -C "$WORKSPACE" tag --list --sort=-version:refname | head -n 1)"
  if [[ -n "$resolved_tag" ]]; then
    git -C "$WORKSPACE" checkout --detach "$resolved_tag"
  else
    if ! git_with_auth -C "$WORKSPACE" fetch --filter=blob:none origin \
      refs/heads/main:refs/remotes/origin/main; then
      log "trusted Orion main fetch failed"
      exit 1
    fi
    git -C "$WORKSPACE" checkout --detach refs/remotes/origin/main
  fi
elif [[ "$source_ref" == "main" ]]; then
  if ! git_with_auth -C "$WORKSPACE" fetch --filter=blob:none origin \
    refs/heads/main:refs/remotes/origin/main; then
    log "trusted Orion main fetch failed"
    exit 1
  fi
  git -C "$WORKSPACE" checkout --detach refs/remotes/origin/main
else
  if ! git_with_auth -C "$WORKSPACE" fetch --filter=blob:none --tags --force origin "$source_ref"; then
    log "trusted Orion ref fetch failed: $source_ref"
    exit 1
  fi
  if git -C "$WORKSPACE" rev-parse --verify "${source_ref}^{commit}" >/dev/null 2>&1; then
    git -C "$WORKSPACE" checkout --detach "$source_ref"
  else
    git -C "$WORKSPACE" checkout --detach FETCH_HEAD
  fi
fi

actual_source="$(git -C "$WORKSPACE" rev-parse HEAD)"
if [[ "$source_ref" =~ ^[0-9a-f]{40}$ && "$actual_source" != "$source_ref" ]]; then
  log "source HEAD mismatch"
  exit 1
fi
origin_actual="$(git -C "$WORKSPACE" remote get-url origin)"
if [[ "$origin_actual" != "$origin_url" ]]; then
  log "source remote URL is not the public https origin"
  exit 1
fi

resolve_release_app_dir "$WORKSPACE" "$source_ref" "$source_ref" >/dev/null
verify_lock_digest_if_present "$SPEC" "$WORKSPACE"
log "source checkout ready at $actual_source (ref $source_ref)"
