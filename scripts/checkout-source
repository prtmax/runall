#!/usr/bin/env bash
# Clone and pin source repository + optional Orion submodule at frozen SHAs.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=scripts/lib/common.sh
source "${ROOT_DIR}/scripts/lib/common.sh"

usage() {
  cat <<'EOF'
Usage: checkout-source --spec <path> --workspace <dir>

Environment:
  COSMOS_BUILD_REPOSITORY_TOKEN  Optional token for private git clones (prepare job only)
EOF
}

SPEC=""
WORKSPACE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --spec) SPEC="$2"; shift 2 ;;
    --workspace) WORKSPACE="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) log "unknown argument: $1"; usage; exit 1 ;;
  esac
done

assert_non_empty "--spec" "$SPEC"
assert_non_empty "--workspace" "$WORKSPACE"
validate_build_spec_document "$SPEC"

repository="$(json_get "$SPEC" '.repository')"
source_commit="$(json_get "$SPEC" '.sourceCommit')"
orion_sha="$(read_orion_commit "$SPEC")"

mkdir -p "$WORKSPACE"

origin_url="$(source_origin_url "$repository")"

# Pass the clone token only as a per-command http.extraheader.
# Never put it in the remote URL or git config.
git_with_auth() {
  if [[ -z "${COSMOS_BUILD_REPOSITORY_TOKEN:-}" ]]; then
    git "$@"
    return
  fi
  local basic
  basic="$(printf 'x-access-token:%s' "$COSMOS_BUILD_REPOSITORY_TOKEN" | base64 | tr -d '\n')"
  git -c "http.extraheader=AUTHORIZATION: basic ${basic}" "$@"
}

if [[ ! -d "${WORKSPACE}/.git" ]]; then
  git init "$WORKSPACE"
  git -C "$WORKSPACE" remote add origin "$origin_url"
fi

git -C "$WORKSPACE" remote set-url origin "$origin_url"
if ! git_with_auth -C "$WORKSPACE" fetch --depth=1 origin "$source_commit"; then
  log "source fetch failed"
  exit 1
fi
git -C "$WORKSPACE" checkout --detach FETCH_HEAD
actual_source="$(git -C "$WORKSPACE" rev-parse HEAD)"
if [[ "$actual_source" != "$source_commit" ]]; then
  log "source HEAD mismatch"
  exit 1
fi
origin_actual="$(git -C "$WORKSPACE" remote get-url origin)"
if [[ "$origin_actual" != "$origin_url" ]]; then
  log "source remote URL is not the public https origin"
  exit 1
fi

if [[ -f "${WORKSPACE}/.gitmodules" ]] && grep -q 'submodule "orion"' "${WORKSPACE}/.gitmodules"; then
  orion_url="$(git -C "$WORKSPACE" config -f .gitmodules --get submodule.orion.url)"
  assert_non_empty "submodule.orion.url" "$orion_url"
  if [[ "$orion_url" =~ ^[A-Za-z][A-Za-z0-9+.-]*:// ]] && [[ ! "$orion_url" =~ ^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(\.git)?$ ]]; then
    log "orion submodule URL is not an https GitHub repository"
    exit 1
  fi
  if [[ ! -e "${WORKSPACE}/orion/.git" ]]; then
    mkdir -p "${WORKSPACE}/orion"
    git init "${WORKSPACE}/orion"
    git -C "${WORKSPACE}/orion" remote add origin "$orion_url"
  fi
  git -C "${WORKSPACE}/orion" remote set-url origin "$orion_url"
  if ! git_with_auth -C "${WORKSPACE}/orion" fetch --depth=1 origin "$orion_sha"; then
    log "orion fetch failed"
    exit 1
  fi
  git -C "${WORKSPACE}/orion" checkout --detach FETCH_HEAD
  actual_orion="$(git -C "${WORKSPACE}/orion" rev-parse HEAD)"
  if [[ "$actual_orion" != "$orion_sha" ]]; then
    log "orion HEAD mismatch"
    exit 1
  fi
fi

resolve_release_app_dir "$WORKSPACE" "$source_commit" "$orion_sha" >/dev/null
log "source checkout ready at $source_commit orion $orion_sha"
