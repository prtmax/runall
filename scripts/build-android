#!/usr/bin/env bash
# Build unsigned Flutter release APK/AAB from a frozen spec.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=scripts/lib/common.sh
source "${ROOT_DIR}/scripts/lib/common.sh"
RUNALL_ROOT="$ROOT_DIR"
# shellcheck source=scripts/lib/build_release.sh
source "${ROOT_DIR}/scripts/lib/build_release.sh"

usage() {
  cat <<'EOF'
Usage: build-android --spec <path> --workspace <dir> [--output-dir <dir>]

The workspace must already contain a detached checkout at the frozen SHAs.
No OIDC, platform tokens, or signing keys are used in this script.
EOF
}

SPEC=""
WORKSPACE=""
OUTPUT_DIR="${RUNALL_ARTIFACT_DIR:-artifacts}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --spec) SPEC="$2"; shift 2 ;;
    --workspace) WORKSPACE="$2"; shift 2 ;;
    --output-dir) OUTPUT_DIR="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) log "unknown argument: $1"; usage; exit 1 ;;
  esac
done

assert_non_empty "--spec" "$SPEC"
assert_non_empty "--workspace" "$WORKSPACE"
if [[ -n "${ANDROID_KEYSTORE_PATH:-}${ANDROID_KEYSTORE_PASSWORD:-}${ANDROID_KEY_PASSWORD:-}${ANDROID_KEY_ALIAS:-}" ]]; then
  log "build-android refuses signing material"
  exit 1
fi

OUTPUT_DIR="$(absolute_path "$OUTPUT_DIR")"
mkdir -p "$OUTPUT_DIR"
prepare_frozen_workspace "$SPEC" "$WORKSPACE"

platform="$(json_get "$SPEC" '.platform')"
if [[ "$platform" != "android" ]]; then
  log "build-android requires platform android"
  exit 1
fi
application_id="$(json_get "$SPEC" '.config.app.applicationId')"
version_name="$(json_get "$SPEC" '.config.app.versionName')"
version_code="$(read_app_version_code "$SPEC")"
assert_non_empty "applicationId" "$application_id"
targets="$(json_get "$SPEC" '.targets | join(",")')"

gen_dir="${APP_DIR}/.runall/release-build"
generate_frozen_release "$gen_dir"
(cd "$APP_DIR" && "$RUNALL_FLUTTER" pub get)

export ANDROID_APPLICATION_ID="$application_id"
build_args=(--release --build-name "$version_name" --build-number "$version_code" --dart-define-from-file "$gen_dir/dart-defines.json")

if [[ "$targets" == *apk* ]]; then
  (cd "$APP_DIR" && "$RUNALL_FLUTTER" build apk "${build_args[@]}")
  apk="${APP_DIR}/build/app/outputs/flutter-apk/app-release.apk"
  [[ -f "$apk" ]] || { log "release apk missing"; exit 1; }
  cp -f "$apk" "${OUTPUT_DIR}/app-release.apk"
fi
if [[ "$targets" == *aab* ]]; then
  (cd "$APP_DIR" && "$RUNALL_FLUTTER" build appbundle "${build_args[@]}")
  aab="${APP_DIR}/build/app/outputs/bundle/release/app-release.aab"
  [[ -f "$aab" ]] || { log "release aab missing"; exit 1; }
  cp -f "$aab" "${OUTPUT_DIR}/app-release.aab"
fi

require_cmd aapt
verify_android() {
  local artifact="$1" badging pkg vname vcode
  badging="$(aapt dump badging "$artifact")"
  pkg="$(printf '%s\n' "$badging" | sed -n "s/package: name='\\([^']*\\)'.*/\\1/p" | head -1)"
  vname="$(printf '%s\n' "$badging" | sed -n "s/package: name='[^']*' versionCode='[^']*' versionName='\\([^']*\\)'.*/\\1/p" | head -1)"
  vcode="$(printf '%s\n' "$badging" | sed -n "s/package: name='[^']*' versionCode='\\([^']*\\)'.*/\\1/p" | head -1)"
  if [[ "$pkg" != "$application_id" || "$vname" != "$version_name" || "$vcode" != "$version_code" ]]; then
    log "android artifact identity does not match the frozen spec"
    exit 1
  fi
}
if [[ "$targets" == *apk* ]]; then
  verify_android "${OUTPUT_DIR}/app-release.apk"
fi
if [[ "$targets" == *aab* ]]; then
  verify_android "${OUTPUT_DIR}/app-release.aab"
fi

log "unsigned android artifacts in $OUTPUT_DIR"
