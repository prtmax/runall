#!/usr/bin/env bash
# Build unsigned Flutter release APK/AAB from a frozen spec (Orion checkout).
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=scripts/lib/common.sh
source "${ROOT_DIR}/scripts/lib/common.sh"

usage() {
  cat <<'EOF'
Usage: build-android --spec <path> --workspace <dir> [--output-dir <dir>]

Environment:
  COSMOS_BUILD_REPOSITORY_TOKEN  Optional token for private git clones
EOF
}

SPEC=""
WORKSPACE=""
OUTPUT_DIR="${RUNALL_ARTIFACT_DIR:-artifacts}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --spec) SPEC="$2"; shift 2 ;;
    --workspace) WORKSPACE="$2"; shift 2 ;;
    --output-dir) OUTPUT_DIR="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) log "unknown argument: $1"; usage; exit 1 ;;
  esac
done

assert_non_empty "--spec" "$SPEC"
assert_non_empty "--workspace" "$WORKSPACE"
validate_build_spec_document "$SPEC"

platform="$(json_get "$SPEC" '.platform')"
if [[ "$platform" != "android" ]]; then
  log "build-android requires platform android"
  exit 1
fi

repository="$(json_get "$SPEC" '.repository')"
source_commit="$(json_get "$SPEC" '.sourceCommit')"
orion_sha="$(json_get "$SPEC" '.orionCommit // .config.orionCommit // empty')"
targets="$(json_get "$SPEC" '.targets | join(",")')"

mkdir -p "$WORKSPACE" "$OUTPUT_DIR"

clone_url="https://github.com/${repository}.git"
if [[ -n "${COSMOS_BUILD_REPOSITORY_TOKEN:-}" ]]; then
  clone_url="https://x-access-token:${COSMOS_BUILD_REPOSITORY_TOKEN}@github.com/${repository}.git"
fi

if [[ ! -d "${WORKSPACE}/.git" ]]; then
  git clone "$clone_url" "$WORKSPACE"
fi

git -C "$WORKSPACE" fetch --depth=1 origin "$source_commit"
git -C "$WORKSPACE" checkout --detach "$source_commit"

if [[ -n "$orion_sha" && -d "${WORKSPACE}/orion" ]]; then
  git -C "$WORKSPACE/orion" fetch --depth=1 origin "$orion_sha" || true
  git -C "$WORKSPACE/orion" checkout --detach "$orion_sha"
  actual="$(git -C "$WORKSPACE/orion" rev-parse HEAD)"
  if [[ "$actual" != "$orion_sha" ]]; then
    log "orion HEAD mismatch"
    exit 1
  fi
fi

app_dir="$WORKSPACE"
[[ -d "${WORKSPACE}/apps/rigel" ]] && app_dir="${WORKSPACE}/apps/rigel"

if [[ -f "${WORKSPACE}/.fvmrc" ]] || [[ -f "${app_dir}/.fvmrc" ]]; then
  require_cmd fvm
  (cd "${app_dir}" && fvm install && fvm flutter --version)
  FLUTTER_CMD=(fvm flutter)
else
  require_cmd flutter
  FLUTTER_CMD=(flutter)
fi

cd "$app_dir"
"${FLUTTER_CMD[@]}" pub get

if [[ "$targets" == *apk* ]]; then
  "${FLUTTER_CMD[@]}" build apk --release
  find build -name '*.apk' -type f -exec cp {} "$OUTPUT_DIR/" \;
fi
if [[ "$targets" == *aab* ]]; then
  "${FLUTTER_CMD[@]}" build appbundle --release
  find build -name '*.aab' -type f -exec cp {} "$OUTPUT_DIR/" \;
fi

if ! find "$OUTPUT_DIR" -maxdepth 1 \( -name '*.apk' -o -name '*.aab' \) | grep -q .; then
  log "no unsigned artifacts in $OUTPUT_DIR"
  exit 1
fi

log "unsigned android artifacts in $OUTPUT_DIR"
