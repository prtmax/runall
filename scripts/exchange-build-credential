#!/usr/bin/env bash
# Exchange GitHub OIDC token for a short-lived Cosmos build credential (phase B).
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=scripts/lib/common.sh
source "${ROOT_DIR}/scripts/lib/common.sh"

usage() {
  cat <<'EOF'
Usage: exchange-build-credential --run-id <id> --output-env <path>

Writes COSMOS_BUILD_CREDENTIAL to the output env file (for GITHUB_ENV).

Environment:
  COSMOS_BUILD_AUTH_EXCHANGE_URL  POST endpoint (e.g. .../internal/build-auth/exchange)
  ACTIONS_ID_TOKEN_REQUEST_URL    Provided by GitHub Actions for OIDC
  ACTIONS_ID_TOKEN_REQUEST_TOKEN  Provided by GitHub Actions for OIDC
  BUILD_RUN_ID                    Platform build run id (or use --run-id)
EOF
}

RUN_ID="${BUILD_RUN_ID:-}"
OUTPUT_ENV=""
OUT_FILE=""
STAGE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --stage) STAGE="$2"; shift 2 ;;
    --run-id) RUN_ID="$2"; shift 2 ;;
    --output-env) OUTPUT_ENV="$2"; shift 2 ;;
    --out) OUT_FILE="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) log "unknown argument: $1"; usage; exit 1 ;;
  esac
done

assert_non_empty "--run-id" "$RUN_ID"
if [[ -z "$OUTPUT_ENV" && -z "$OUT_FILE" ]]; then
  assert_non_empty "--output-env or --out" ""
fi
assert_non_empty "COSMOS_BUILD_AUTH_EXCHANGE_URL" "${COSMOS_BUILD_AUTH_EXCHANGE_URL:-}"

require_cmd curl
require_cmd jq
response_file="$(mktemp)"
trap 'rm -- "$response_file"' EXIT

oidc_token=""
if [[ -n "${COSMOS_BUILD_OIDC_TOKEN:-}" ]]; then
  oidc_token="${COSMOS_BUILD_OIDC_TOKEN}"
elif [[ -n "${ACTIONS_ID_TOKEN_REQUEST_URL:-}" && -n "${ACTIONS_ID_TOKEN_REQUEST_TOKEN:-}" ]]; then
  curl "${PLATFORM_CURL_ARGS[@]}" --fail -sS --output "$response_file" \
    -H "Authorization: bearer ${ACTIONS_ID_TOKEN_REQUEST_TOKEN}" \
    "${ACTIONS_ID_TOKEN_REQUEST_URL}&audience=cosmos-build"
  oidc_token="$(jq -r .value "$response_file")"
else
  log "no OIDC token available (set COSMOS_BUILD_OIDC_TOKEN for local tests)"
  exit 1
fi

payload="$(jq -n --arg runId "$RUN_ID" --arg token "$oidc_token" '{runId: $runId, githubOidcToken: $token}')"
primary_url="${COSMOS_BUILD_AUTH_EXCHANGE_URL}"
declare -a exchange_urls=("$primary_url")
if [[ "$primary_url" == "https://mercury-stg.iprtapp.com/api/v1/runtime/internal"* ]]; then
  exchange_urls+=("https://p8018.birch.iprtapp.com/api/v1/runtime/internal/build-auth/exchange")
elif [[ "$primary_url" == "https://p8018.birch.iprtapp.com/api/v1/runtime/internal"* ]]; then
  exchange_urls+=("https://mercury-stg.iprtapp.com/api/v1/runtime/internal/build-auth/exchange")
fi

response=""
resolved_exchange_url=""
for candidate_url in "${exchange_urls[@]}"; do
  # A file lets curl rewind partially received JSON before retrying. Failed
  # response bodies never enter the recovered credential document.
  if curl "${PLATFORM_CURL_ARGS[@]}" --fail -sS --output "$response_file" -X POST \
    -H 'Content-Type: application/json' \
    --data-binary "$payload" \
    "$candidate_url"; then
    response="$(cat "$response_file")"
    resolved_exchange_url="$candidate_url"
    break
  fi
  log "OIDC exchange attempt failed against ${candidate_url}; trying fallback if configured"
done

if [[ -z "$resolved_exchange_url" ]]; then
  log "OIDC exchange failed for run $RUN_ID"
  exit 1
fi

credential="$(echo "$response" | jq -r '.accessToken // .token // empty')"
assert_non_empty "accessToken" "$credential"
# Register before exposing the credential through files used by later steps.
if [[ "${GITHUB_ACTIONS:-}" == true ]]; then
  printf '::add-mask::%s\n' "$credential"
fi

if [[ -n "$OUT_FILE" ]]; then
  printf '%s\n' "$credential" > "$OUT_FILE"
fi
if [[ -n "$OUTPUT_ENV" ]]; then
  echo "COSMOS_BUILD_CREDENTIAL=${credential}" >> "$OUTPUT_ENV"
  if [[ "$resolved_exchange_url" == *"/build-auth/exchange" ]]; then
    resolved_base="${resolved_exchange_url%/build-auth/exchange}"
    if [[ "$resolved_base" == https://*/internal ]]; then
      echo "COSMOS_BUILD_RESOLVED_BASE_URL=${resolved_base}" >> "$OUTPUT_ENV"
    fi
  fi
fi
log "build credential exchanged for run $RUN_ID"
